# Copiar a .env y ajustar valores
# Puerto del servidor
PORT=5000

# Base de datos (modo mock: DB_USE_MOCK=true no requiere MySQL)
DB_USE_MOCK=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aztlan26

UPLOAD_FOLDER=uploads/comprobantes

# Gmail para envío de correos (registro, pago aprobado, notificación a admins)
# Usar torneoaztlan@gmail.com y la contraseña de aplicación de Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Correo de admins (notificación cuando un usuario sube comprobante; por defecto example@gmail.com)
# ADMIN_EMAIL=example@gmail.com
